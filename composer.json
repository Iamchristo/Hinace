{
    "name": "hinace/platform",
    "description": "Unified investment, forex/markets, and real-estate platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "ext-bcmath": "*",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^6.10",
        "spomky-labs/otphp": "^11.3",
        "monolog/monolog": "^3.7",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/migrate.php"
    },
    "config": {
        "sort-packages": true
    }
}
