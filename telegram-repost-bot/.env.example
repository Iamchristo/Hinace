# Get these from https://my.telegram.org (API development tools)
TG_API_ID=
TG_API_HASH=

# Name/path for the session file created by login.py (no extension).
# If running via docker-compose, use "data/repost_bot" so it lands in the
# bind-mounted ./data folder and survives container rebuilds.
TG_SESSION_NAME=repost_bot

# Seconds to wait for an album's remaining items before reposting (grouped_id buffering)
TG_ALBUM_DEBOUNCE_SECONDS=2
